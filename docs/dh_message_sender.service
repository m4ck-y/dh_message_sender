[Unit]
Description=DH Message Sender — PulseCore
After=network.target

[Service]
User=m4ck-y
WorkingDirectory=/home/m4ck-y/.me/dh/dh_message_sender

Environment="PYTHONUNBUFFERED=1"
Environment="ROOT_PATH=/api/message_sender"

ExecStart=/home/m4ck-y/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8091

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
# API Configuration
APP_NAME=PulseCore
ENVIRONMENT=development
DEBUG=False
ROOT_PATH="/api/notify"

# CORS
CORS_ORIGINS=*
ALLOWED_ORIGINS=*
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# SMTP
# SMTP_HOST=<smtp.gmail.com>
# SMTP_USERNAME=<tu-email@gmail.com>
# SMTP_PASSWORD=<your-app-password>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<your-email>
SMTP_PASSWORD=<your-app-password>
SMTP_FROM_EMAIL=<your-email>
SMTP_USE_TLS=True
SMTP_STARTTLS=True

# Branding — used in email templates
COMPANY_NAME=Digital Hospital
COMPANY_LOGO_URL=
SUPPORT_EMAIL=<support@example.com>
WEBSITE_URL=https://example.com

# Service URLs
# SERVICE_<SERVICE_NAME>_URL=<protocolo>://<host>:<puerto>
SERVICE_LOGGER_URL=http://localhost:8092